<Bindings>

	<!-- Toggle panel -->
	<Binding name="RGXQO_GLOBAL_TOGGLE" category = "RGX QoL">
		SlashCmdList["RGXQoL"]()
	</Binding>

	<!-- Show web link -->
	<Binding name="RGXQO_GLOBAL_WEBLINK" category = "RGX QoL">
